    { "es": "principio", "en": "beginning", "note": "en el principio = in the beginning" },
    { "es": "creó", "en": "he created", "note": "story word from Génesis 1" },
    { "es": "vio", "en": "he saw", "note": "story word" },
    { "es": "era", "en": "it was", "note": "story word" },
