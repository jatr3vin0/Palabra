    { "es": "hombre", "en": "man, human being", "note": "story word" },
    { "es": "llave", "en": "key", "note": "ll sounds like the y in «yes»" },
    { "es": "mañana", "en": "morning; tomorrow", "note": "ñ sounds like the ny in «canyon»" },
    { "es": "jardín", "en": "garden", "note": "j sounds like a strong English h" },
    { "es": "español", "en": "Spanish" }
