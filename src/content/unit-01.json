  "title": "¡Hola! — Primeros saludos",
  "subtitle": "Greet someone, say your name, and talk about your family",
  "theme": "A first morning in a new town — say hello, meet a family, and hear how the story began",
  "storyThread": "La creación (Génesis 1): Dios crea la luz, la tierra y la familia humana — told in very simple Spanish",
  "vocab": [
    { "es": "hola", "en": "hello", "note": "the h is silent: OH-lah" },
    { "es": "buenos días", "en": "good morning", "note": "used until about noon" },
    { "es": "buenas tardes", "en": "good afternoon", "note": "used from noon until dark" },
    { "es": "buenas noches", "en": "good evening / good night", "note": "hello after dark, and goodbye at bedtime" },
    { "es": "adiós", "en": "goodbye" },
    { "es": "hasta luego", "en": "see you later" },
    { "es": "hasta mañana", "en": "see you tomorrow" },
    { "es": "me llamo", "en": "my name is", "note": "from llamarse; literally «I call myself»" },
    { "es": "¿Cómo te llamas?", "en": "What is your name?", "note": "to a friend, a child, someone your age" },
    { "es": "¿Cómo se llama usted?", "en": "What is your name?", "note": "polite, to an adult you do not know well" },
    { "es": "tú", "en": "you", "note": "familiar" },
    { "es": "usted", "en": "you", "note": "polite; takes the same verb form as él/ella" },
    { "es": "¿y tú?", "en": "and you?", "note": "familiar" },
    { "es": "¿y usted?", "en": "and you?", "note": "polite" },
    { "es": "soy", "en": "I am", "note": "from ser" },
    { "es": "eres", "en": "you are", "note": "from ser, familiar" },
    { "es": "es", "en": "he / she / it is", "note": "from ser" },
    { "es": "mucho gusto", "en": "pleased to meet you" },
    { "es": "por favor", "en": "please" },
    { "es": "gracias", "en": "thank you" },
    { "es": "muchas gracias", "en": "thank you very much" },
    { "es": "de nada", "en": "you're welcome", "note": "literally «of nothing»" },
    { "es": "perdón", "en": "sorry / pardon me" },
    { "es": "disculpe", "en": "excuse me", "note": "polite, to usted" },
    { "es": "lo siento", "en": "I am sorry" },
    { "es": "familia", "en": "family" },
    { "es": "madre", "en": "mother" },
    { "es": "padre", "en": "father" },
    { "es": "hermano", "en": "brother" },
    { "es": "hermana", "en": "sister" },
    { "es": "hijo", "en": "son", "note": "the h is silent: EE-ho" },
    { "es": "hija", "en": "daughter", "note": "the h is silent: EE-ha" },
    { "es": "mi", "en": "my", "note": "mi madre, mi padre — one person" },
    { "es": "bueno", "en": "good", "note": "buena before a feminine word: buena luz" },
    { "es": "Dios", "en": "God" },
    { "es": "amor", "en": "love" },
    { "es": "luz", "en": "light" },
    { "es": "tierra", "en": "earth, land" },
    { "es": "cielo", "en": "sky; los cielos = the heavens" },
    { "es": "día", "en": "day", "note": "masculine, even though it ends in -a" },
